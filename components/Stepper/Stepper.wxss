/* 步进器容器 - 水平flex布局 */
.stepper-container {
  display: flex;
  align-items: center;
  height: 60rpx;
}

/* 增减按钮 */
.stepper-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 60rpx;
  height: 60rpx;
}

/* 按钮图标 */
.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 数量显示 */
.stepper-count {
  width: 80rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}