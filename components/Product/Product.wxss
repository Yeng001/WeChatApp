.productBack{
  background-color: #2c2c2c;
  position: relative;
  padding: 20rpx;
  border-radius: 8rpx;
}

.auto-img{
  width: 100%;
  display: block;
}

.pro-info{
  margin-top: 10rpx;
}

.name{
  font-size: 28rpx;
}

.priceBox{
  display: flex;
  margin-top: 10rpx;
  align-items: center;
}

.priceImgBox{
  width: 33rpx;
  height: 33rpx;
  display: flex;
}

.price{
  font-size: 28rpx;
  color:red;
  font-weight: bold;
  
}

.one-text{
  white-space: nowrap;
  overflow:hidden;
  text-overflow: ellipsis;
  
}

.img-box{
  position: relative;
}

.tag{
  position: absolute;
  height: 36rpx;
  right: 0;
  top: 0;
  background-color: #DB1A4B;
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-top-left-radius: 22rpx;
}

/* 添加到购物车按钮样式 */
.add-cart-btn {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.add-cart-icon {
  width: 40rpx;
  height: 40rpx;
}