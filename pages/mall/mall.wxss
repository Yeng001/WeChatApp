/* 商城页面容器 */
.mall-container {
  background-color: #1a1a1a;
  min-height: 100vh;
  color: #fff;
}

/* 搜索+筛选栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: #2c2c2c;
}

/* 搜索框 */
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #444;
  border-radius: 60rpx;
  padding: 12rpx 20rpx;
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  background-color: transparent;
}
.search-placeholder {
  color: #999;
}

/* 筛选按钮 */
.filter-btn {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}
.filter-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 5rpx;
}
.filter-text {
  font-size: 28rpx;
}

/* 筛选面板 */
.filter-panel {
  background-color: #2c2c2c;
  padding: 20rpx;
  border-top: 1rpx solid #444;
}
.filter-item {
  margin-bottom: 25rpx;
}
.filter-label {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  display: block;
}
.option-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}
.option {
  padding: 10rpx 20rpx;
  background-color: #444;
  border-radius: 6rpx;
  font-size: 26rpx;
}
.option-active {
  background-color: #DB1A4B;
  color: #fff;
}

/* 筛选面板操作按钮 */
.filter-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.reset-btn {
  width: 48%;
  height: 70rpx;
  background-color: #DB1A4B;
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
}
.confirm-btn {
  width: 48%;
  height: 70rpx;
  background-color: #DB1A4B;
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx;
}
.product-item {
  width: 48%;
  margin-bottom: 20rpx;
}