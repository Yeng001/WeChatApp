.login-container {
  padding: 40rpx;
  min-height: 100vh;
  background-color: #f8f8f8;
}

/* 头部样式 */
.header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

/* 输入行样式 */
.input-row {
  margin-bottom: 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.input-label {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input-field {
  font-size: 30rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  width: 100%;
}

/* 密码输入容器 */
.password-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.input-field-pwd {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
}

/* 登录按钮样式 */
.login-btn {
  background-color: #07c160;
  border-radius: 12rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 50rpx 0 30rpx 0;
  transition: all 0.3s;
}

.login-btn:active {
  background-color: #06ad56;
  transform: scale(0.98);
}

.btn-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
}

/* 链接样式 */
.link-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 50rpx;
  padding: 0 10rpx;
}

.link-text {
  font-size: 28rpx;
  color: #576b95;
  padding: 10rpx 20rpx;
}

.link-text:active {
  color: #455a8c;
}

/* 提示信息样式 */
.tips-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tips-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.tips-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

/* 占位符样式 */
.input-field::placeholder,
.input-field-pwd::placeholder {
  color: #999;
  font-size: 28rpx;
}