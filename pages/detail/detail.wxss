/* 全局样式重置 */
page {
  background-color: #1a1a1a;
  color: #fff;
  padding-bottom: 120rpx; /* 给底部操作栏留空间 */
}

/* 详情整体容器 */
.detail-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #1a1a1a;
}

/* 商品图片区域 */
.goods-img-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 0;
  background-color: #2c2c2c;
}
.goods-img {
  width: 100%;
  height: auto; /* 自适应高度 */
}

/* 商品信息区域 */
.goods-info-wrap {
  flex: 1;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 商品名称+价格区域 */
.goods-header {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}



.goods-g {
  background-color: #DB1A4B;
  color: #fff;
  font-size: 24rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  line-height: 32rpx;
}

.goods-n{
  display: flex;
  align-items: center;
  gap: 8rpx; /* 标签和名称之间的间距 */
  margin: 16rpx 0;
}

.goods-name {
  font-size: 34rpx;
  color: #fff;
  font-weight: 500;
}
.goods-eng-name {
  font-size: 26rpx;
  color: #999;
}
.price-wrap {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.price-icon {
  width: 38rpx;
  height: 38rpx;
  
}
.goods-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #DB1A4B;
}

/* 数量选择区域 */
.count-select-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  border-top: 1rpx solid #333;
  border-bottom: 1rpx solid #333;
}
.count-label {
  font-size: 28rpx;
  color: #fff;
}

/* 商品描述区域 */
.goods-desc-wrap {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.desc-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}
.desc-content {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.6;
}
.desc-item {
  display: block;
  margin-bottom: 10rpx;
}

/* 底部固定操作栏 */
.bottom-operate-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #2c2c2c;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.3);
}

.bar-count{
  position: absolute;
  right: 25rpx;
  top: -10px;
  width: 32rpx;
  height: 32rpx;
  background-color: #DB1A4B;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 32rpx;
  border-radius: 50%;
}

.bar-btn {
  width: 20%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5rpx;
  position: relative;
}
.bar-icon {
  width: 36rpx;
  height: 36rpx;
}
.bar-text {
  font-size: 22rpx;
  color: #fff;
}
/* 加入购物袋主按钮 */
.bar-main-btn {
  flex: 1;
  height: 70rpx;
  background-color: #DB1A4B;
  border-radius: 35rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
}
.main-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}